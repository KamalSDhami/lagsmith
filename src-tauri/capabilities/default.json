{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Lagsmith's own read-only commands. No core plugins (events, window, path, etc.).",
  "windows": ["main"],
  "permissions": [
    "allow-get-hardware",
    "allow-get-storage",
    "allow-get-caches",
    "allow-get-stability",
    "allow-get-startup",
    "allow-get-memory",
    "allow-get-security",
    "allow-check-driver-updates"
  ]
}
