{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Lagsmith's own commands: read-only scans, plus apply_changes/undo_change, which validate everything in Rust. Only the event listener core permissions, for the close prompt.",
  "windows": ["main"],
  "permissions": [
    "allow-get-hardware",
    "allow-get-storage",
    "allow-get-caches",
    "allow-get-stability",
    "allow-get-startup",
    "allow-get-memory",
    "allow-get-security",
    "allow-check-driver-updates",
    "allow-get-system",
    "allow-get-anticheat",
    "allow-list-crash-dumps",
    "allow-get-disk-usage",
    "allow-get-store-apps",
    "allow-get-gpu-preferences",
    "allow-get-history",
    "allow-apply-changes",
    "allow-undo-change",
    "allow-run-admin-task",
    "allow-get-background-repair",
    "allow-close-app",
    "allow-get-settings",
    "allow-set-settings",
    "allow-get-findings-history",
    "allow-record-scan",
    "allow-get-dump-analysis",
    "allow-clean-memory",
    "allow-open-external",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
